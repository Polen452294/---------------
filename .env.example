APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://booking:booking@postgres:5432/booking
REDIS_URL=redis://redis:6379/0

# Public HTTPS origin without a trailing slash, for example https://booking.example.com
TELEGRAM_WEBHOOK_BASE_URL=

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_TOKEN_ENCRYPTION_KEY=

# Booking defaults
BOOKING_HORIZON_DAYS=60
BOOKING_MIN_LEAD_HOURS=3
SLOT_HOLD_MINUTES=10
CANCELLATION_CUTOFF_HOURS=24
BOOKING_DATES_SHOWN=14
NOTIFICATION_POLL_INTERVAL_SECONDS=2
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5
WORKER_BUSINESS_SLUG=demo

# Used only by `booking-admin register-bot`; never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
DOCKER_TELEGRAM_PROXY_URL=
TELEGRAM_WEBHOOK_HEADER_SECRET=
